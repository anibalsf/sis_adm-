# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA SINDICATO TAIPIPLAYA
# ==============================================================================
# Copiar este archivo como .env y configurar los valores apropiados
# NUNCA subir el archivo .env a git

# ------------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# ------------------------------------------------------------------------------
# SECURITY WARNING: keep the secret key used in production secret!
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION

# SECURITY WARNING: don't run with debug turned on in production!
# Valores: True | False
DEBUG=True

# Hosts permitidos (separados por coma)
# Ejemplo: localhost,127.0.0.1,midominio.com
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# DATABASE SETTINGS
# ------------------------------------------------------------------------------
# Opciones: sqlite | mysql | postgresql
# RECOMENDADO: postgresql (mejor para producción)
DB_ENGINE=sqlite

# ==============================================================================
# CONFIGURACIÓN POSTGRESQL (Recomendado para producción)
# ==============================================================================
# DB_ENGINE=postgresql
# DB_NAME=sindicato_taipiplaya
# DB_USER=admin_sindicato
# DB_PASSWORD=TuPasswordSeguro123!
# DB_HOST=localhost
# DB_PORT=5432

# ==============================================================================
# CONFIGURACIÓN MYSQL (Alternativa)
# ==============================================================================
# DB_ENGINE=mysql
# DB_NAME=sindicato_taipiplaya
# DB_USER=root
# DB_PASSWORD=TuPasswordMySQL123!
# DB_HOST=localhost
# DB_PORT=3306

# ==============================================================================
# CONFIGURACIÓN SQLITE (Solo para desarrollo)
# ==============================================================================
# DB_ENGINE=sqlite
# (No requiere otros parámetros, usa db.sqlite3 en el directorio raíz)

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Token expiration time in seconds (default: 86400 = 24 hours)
TOKEN_EXPIRATION=86400

# CORS Settings (para frontend separado)
# Valores: True | False
CORS_ENABLED=True

# Orígenes permitidos para CORS (separados por coma)
# Ejemplo: http://localhost:3000,https://app.midominio.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Permitir cookies en requests CORS
CORS_ALLOW_CREDENTIALS=True

# ------------------------------------------------------------------------------
# STATIC & MEDIA FILES
# ------------------------------------------------------------------------------
# URL base para archivos estáticos
STATIC_URL=/static/

# Directorio para archivos estáticos en producción
STATIC_ROOT=staticfiles/

# URL base para archivos de media
MEDIA_URL=/media/

# Directorio para archivos de media
MEDIA_ROOT=media/

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
# Nivel de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Directorio para archivos de log
LOG_DIR=logs

# ------------------------------------------------------------------------------
# EXTERNAL SERVICES
# ------------------------------------------------------------------------------
# WhatsApp Integration (opcional)
WHATSAPP_WEBHOOK_URL=

# Twilio Integration (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp via Twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email Configuration (para notificaciones)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------------------------------------------
# BUSINESS LOGIC
# ------------------------------------------------------------------------------
# Monto de sanción por ausencia (en Bs)
SANCTION_ABSENCE_AMOUNT=50

# ------------------------------------------------------------------------------
# API CONFIGURATION
# ------------------------------------------------------------------------------
# Paginación por defecto
PAGE_SIZE=20

# ------------------------------------------------------------------------------
# REDIS (opcional - para caching)
# ------------------------------------------------------------------------------
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------------------------
# Valores: development | staging | production
ENVIRONMENT=development
